{
  "name": "freelancer-reply-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.mjs",
    "cf-typegen": "wrangler types",
    "db:migrate:local": "wrangler d1 migrations apply freelancer-reply-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply freelancer-reply-db --remote"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260808.1",
    "typescript": "^5.9.2",
    "wrangler": "^4.120.0"
  }
}
