{
  "openapi": "3.1.0",
  "info": {
    "title": "FreelancerReply Backend API",
    "version": "2026-08-07.v2-amended"
  },
  "servers": [
    { "url": "https://freelancer-reply-api.huangzhenhui0303.workers.dev" }
  ],
  "x-product-boundary": {
    "p0": true,
    "login": "anonymous httpOnly session only",
    "payment": false,
    "automaticEmailSending": false,
    "generatorInputsStoredServerSide": false,
    "waitlistEmailStored": true,
    "aiProvider": "openrouter",
    "aiModel": "openai/gpt-4.1-mini",
    "outputMode": "recommended_reminder_single_draft",
    "costTracking": true
  },
  "paths": {
    "/api/health": { "get": { "summary": "Health check", "responses": { "200": { "description": "Backend status, bindings, limits" } } } },
    "/api/auth/login": { "post": { "summary": "Create anonymous httpOnly quota session", "x-rate-limit": "30 per IP/day", "responses": { "200": { "description": "Sets fr_session cookie" }, "429": { "description": "RATE_LIMITED" } } } },
    "/api/auth/me": { "get": { "summary": "Read current anonymous session and P0 entitlements", "responses": { "200": { "description": "Current actor, plan, entitlements" } } } },
    "/api/usage": { "get": { "summary": "Read reminder session quota, refinement quota, hourly AI rate-limit bucket, waitlist quota, and actor AI cost summary", "responses": { "200": { "description": "usage.generatePaymentReminder, usage.refinePaymentReminder, usage.hourlyAiCalls, usage.waitlistSubmit, usage.aiCostSummary. hourlyAiCalls is IP-scoped for frontend preflight; backend still enforces it on request." } } } },
    "/api/generate-payment-reminder": {
      "post": {
        "summary": "Generate one situation-aware recommended late payment reminder draft",
        "x-auth": "optional anonymous session; IP fallback; Turnstile token required when TURNSTILE_SECRET_KEY is configured",
        "x-cost-impact": "high; records OpenRouter token usage and provider cost",
        "x-rate-limit": "Anonymous P0: 2 initial reminder sessions/day; refinements tracked separately; 4 AI calls/IP/hour; Turnstile required before provider call",
        "x-data-stored": "usage log, quota counter, task input_hash, ai_generation_costs token/cost row; raw generator input/output not stored",
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": {
            "type": "object",
            "required": ["clientName", "invoiceAmount", "daysOverdue", "projectType"],
            "properties": {
              "clientName": { "type": "string", "maxLength": 80 },
              "invoiceAmount": { "type": "string", "maxLength": 80 },
              "daysOverdue": { "type": "number", "minimum": -30, "maximum": 3650 },
              "projectType": { "type": "string", "maxLength": 120 },
              "previousRemindersSent": { "enum": ["none", "one", "two", "three_plus"] },
              "recommendedStage": { "enum": ["Due Soon / Due Today", "Gentle Reminder", "Firm Reminder", "Final Notice"] },
              "refinementMode": { "enum": ["initial", "softer", "firmer", "regenerate"] },
              "stageReason": { "type": "string", "maxLength": 700 },
              "tone": { "type": "string" },
              "invoiceNumber": { "type": "string", "maxLength": 80 },
              "paymentLink": { "type": "string", "format": "uri" },
              "clientRelationship": { "type": "string", "maxLength": 120 },
              "turnstileToken": { "type": "string" }
            }
          } } }
        },
        "responses": {
          "200": { "description": "{recommendedStage,stageReason,subject,emailBody,shortMessage,riskNotice?,disclaimer,meta}" },
          "400": { "description": "VALIDATION_ERROR / unsafe_input" },
          "402": { "description": "QUOTA_EXCEEDED" },
          "429": { "description": "RATE_LIMITED" },
          "503": { "description": "PROVIDER_UNAVAILABLE" }
        }
      }
    },
    "/api/waitlist": { "post": { "summary": "Submit Pro waitlist interest", "x-rate-limit": "10 per IP/session/day", "responses": { "200": { "description": "Waitlist stored / updated" } } } },
    "/api/events": { "post": { "summary": "Optional first-party analytics event collection", "responses": { "200": { "description": "Event accepted" } } } }
  }
}
