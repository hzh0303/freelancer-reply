{
  "name": "freelancer-reply",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-08-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true
  },
  "workers_dev": true,
  "preview_urls": true,
  "vars": {
    "API_UPSTREAM_URL": "https://api.freelancerreply.com"
  },
  "routes": [
    { "pattern": "freelancerreply.com/*", "zone_name": "freelancerreply.com" },
    { "pattern": "www.freelancerreply.com/*", "zone_name": "freelancerreply.com" }
  ]
}
